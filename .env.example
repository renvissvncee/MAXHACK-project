# Local Docker Compose configuration; replace before running.
POSTGRES_USER=priut
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=priut
BACKEND_PORT=8000

# MAX bot (never commit a real token)
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_MINI_APP_ENABLED=false

# Local HTTP only. Set true with HTTPS deployment.
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Optional: CA bundle mounted from .certs/ for the Docker bot.
# MAX_CA_FILE=/run/max-certs/max-ca.pem

# Enable only when ready to deliver real MAX notifications.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_POLL_SECONDS=5
NOTIFICATION_SEND_INTERVAL_SECONDS=1.1
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_LEASE_SECONDS=120
